<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SubTracker" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Тема заставки. Ставится Activity в манифесте; installSplashScreen()
        после показа заменяет её на postSplashScreenTheme.
        На Android 12+ это штатный системный splash, на 8–11 его имитирует
        библиотека core-splashscreen.
    -->
    <style name="Theme.SubTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SubTracker</item>
    </style>
</resources>
